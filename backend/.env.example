PORT=8080
DATABASE_URL="postgresql://user:password@localhost:5432/healthtech"

# Access token (Bearer, en memoria del cliente) — vida corta
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="15m"

# Refresh token (cookie httpOnly, rotado en cada refresh) — vida larga.
# Debe ser un secret DISTINTO de JWT_SECRET.
JWT_REFRESH_SECRET="change-me-to-a-different-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
