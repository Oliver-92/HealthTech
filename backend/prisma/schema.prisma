// HealthTech — Prisma 7 schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CAREGIVER
  PATIENT
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
}

enum PaymentStatus {
  CREATED
  INITIATED
  COMPLETED
  FAILED
}

enum PaymentReportStatus {
  GENERATED
  PAYMENT_IN_PROGRESS
  PAID
  PAYMENT_FAILED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  caregiver       Caregiver?
  patient         Patient?
  reviewedReports Report[]   @relation("ReviewedBy")

  @@map("users")
}

model Caregiver {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  documentId String   @unique @map("document_id")
  phone      String?
  hourlyRate Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  isActive   Boolean  @default(true) @map("is_active")
  hiredAt    DateTime @map("hired_at") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  shifts         Shift[]
  reports        Report[]
  paymentReports PaymentReport[]

  @@map("caregivers")
}

model Patient {
  id               Int       @id @default(autoincrement())
  // userId is optional: a patient can exist without a login account
  userId           Int?      @unique @map("user_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  documentId       String    @unique @map("document_id")
  birthDate        DateTime? @map("birth_date") @db.Date
  address          String?
  phone            String?
  emergencyContact String?   @map("emergency_contact")
  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id])
  shifts  Shift[]
  reports Report[]

  @@map("patients")
}

model Shift {
  id          Int         @id @default(autoincrement())
  patientId   Int         @map("patient_id")
  caregiverId Int         @map("caregiver_id")
  date        DateTime    @db.Date
  // HH:MM format — no native TIME type in Prisma, String is portable
  startTime   String      @map("start_time")
  endTime     String      @map("end_time")
  status      ShiftStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  patient   Patient   @relation(fields: [patientId], references: [id])
  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
  report    Report?

  @@index([caregiverId])
  @@index([patientId])
  @@index([date])
  @@map("shifts")
}

model Report {
  id            Int          @id @default(autoincrement())
  shiftId       Int          @unique @map("shift_id")
  caregiverId   Int          @map("caregiver_id")
  patientId     Int          @map("patient_id")
  workedMinutes Int          @map("worked_minutes")
  observations  String?
  medication    String?
  vitalSigns    String?      @map("vital_signs")
  status          ReportStatus @default(DRAFT)
  rejectionReason String?      @map("rejection_reason")
  reviewedById    Int?         @map("reviewed_by_id")
  reviewedAt      DateTime?    @map("reviewed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  shift      Shift     @relation(fields: [shiftId], references: [id])
  caregiver  Caregiver @relation(fields: [caregiverId], references: [id])
  patient    Patient   @relation(fields: [patientId], references: [id])
  reviewedBy User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([caregiverId])
  @@index([patientId])
  @@index([status])
  @@map("reports")
}

model PayrollPeriod {
  id        Int      @id @default(autoincrement())
  month     DateTime @db.Date
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paymentReports PaymentReport[]

  @@map("payroll_periods")
}

model PaymentReport {
  id              Int                 @id @default(autoincrement())
  payrollPeriodId Int                 @map("payroll_period_id")
  caregiverId     Int                 @map("caregiver_id")
  totalTimeMins   Int                 @map("total_time_mins")
  totalAmount     Decimal             @map("total_amount") @db.Decimal(12, 2)
  status          PaymentReportStatus @default(GENERATED)
  generatedAt     DateTime            @default(now()) @map("generated_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  caregiver     Caregiver     @relation(fields: [caregiverId], references: [id])
  payments      Payment[]

  // One report per caregiver per period
  @@unique([payrollPeriodId, caregiverId])
  @@index([caregiverId])
  @@map("payment_reports")
}

model Payment {
  id                   Int           @id @default(autoincrement())
  paymentReportId      Int           @map("payment_report_id")
  paymentMethod        PaymentMethod @map("payment_method")
  paymentStatus        PaymentStatus @default(CREATED) @map("payment_status")
  initiatedAt          DateTime?     @map("initiated_at")
  completedAt          DateTime?     @map("completed_at")
  transactionReference String?       @map("transaction_reference")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  paymentReport PaymentReport @relation(fields: [paymentReportId], references: [id])

  @@index([paymentStatus])
  @@map("payments")
}
